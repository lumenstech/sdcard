# Secure4K Sidecar Platform — environment template.
# Copy to .env and fill in real values before `make up`.

# ---- API tokens (REQUIRED) ------------------------------------------
# Comma-separated bearer tokens accepted by the ingest API. Generate with:
#   openssl rand -hex 32
VALID_API_KEYS=replace-me-with-a-strong-token

# ---- SequenceNow alerting (optional but recommended) ----------------
# Without these, alerts are logged but not delivered.
SEQUENCENOW_URL=https://api.sequencenow.com
SEQUENCENOW_API_KEY=

# ---- Inference -------------------------------------------------------
INFERENCE_MODEL=llava
INFERENCE_THRESHOLD=0.6
INFERENCE_TIMEOUT=20s

# ---- Pipeline tuning -------------------------------------------------
PIPELINE_WORKERS=4
PIPELINE_QUEUE_SIZE=1000
FRAME_TIMEOUT=45s

# ---- Per-device rate limit (frames/sec, burst) ----------------------
RATE_LIMIT_PER_SEC=2
RATE_LIMIT_BURST=10
